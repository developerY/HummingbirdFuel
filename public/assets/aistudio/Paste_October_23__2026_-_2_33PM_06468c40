        // Mathematical Bateman Equation Solver for Caffeine PK/PD
        function calculatePKPDCurves(genotype, strategy) {
            const points = 97; // 24 hours at 15-min increments
            const ka = 2.0; // Absorption rate (1/hr)
            
            // Half-life: Fast AA = 3 hrs (ke = 0.231), Slow CC = 9 hrs (ke = 0.077)
            const ke = (genotype === 'fast') ? 0.231 : 0.077;

            // Define dose events [timeInHours, doseInMg]
            let doses = [];
            if (strategy === 'bolus') {
                doses = [[8.0, 200]]; // 200mg single coffee bolus at 08:00
            } else if (strategy === 'micro') {
                doses = [[8.0, 25], [10.5, 25], [13.0, 25], [15.5, 25]]; // 4x 25mg microdoses
            } else if (strategy === 'late') {
                doses = [[8.0, 100], [13.0, 50], [18.5, 50]]; // Late microdose at 18:30
            }

            const McData = [];
            const PData = [];

            for (let idx = 0; idx < points; idx++) {
                const t = idx * 0.25; // current hour

                // 1. Calculate circulating drug mass Mc(t) via linear superposition of Bateman equations
                let Mc = 0;
                for (let d of doses) {
                    const t_d = d[0];
                    const dose = d[1];
                    if (t >= t_d) {
                        const dt = t - t_d;
                        const conc = dose * (ka / (ka - ke)) * (Math.exp(-ke * dt) - Math.exp(-ka * dt));
                        Mc += Math.max(0, conc);
                    }
                }
                McData.push(Mc);

                // 2. Calculate baseline sleepiness P0(t) = S(t) + C(t) (Borbély Two-Process Model)
                // S(t) homeostatic buildup from waking at 06:00
                const wakeTime = 6.0;
                const awakeHours = (t >= wakeTime) ? (t - wakeTime) : (t + 18.0);
                const S = 250 + 150 * (1 - Math.exp(-0.08 * awakeHours));

                // C(t) circadian oscillation (24-hr harmonic peaking around 17:00, trough at 05:00)
                const C = 40 * Math.sin((2 * Math.PI / 24) * (t - 11.0));

                const P0 = S + C;

                // 3. Pharmacodynamic reduction factor g_PD(t) via Hill equation
                const M0 = 0.8;
                const g_PD = 1 / (1 + M0 * (Mc / 30.0));

                // Multiplicative Alertness Impairment P(t) in milliseconds
                const P = P0 * g_PD;
                PData.push(P);
            }

            return { Mc: McData, P: PData };
        }


