                card.className = "p-5 rounded-xl border border-teal-200 bg-teal-50/50 flex flex-col justify-between";
                badge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-teal-100 text-teal-800";
                badge.innerText = "General Wellness Exempt";
                icon.innerText = "🌿";
                title.innerText = "FDA Enforcement Discretion (Low Risk)";
                desc.innerText = "Compliant with January 2026 General Wellness Guidance. Exempt from premarket submission and Section 524B mandates.";
                details.innerHTML = `
                    <p><strong>• Labeling Limit:</strong> Must make zero disease claims or medical diagnosis statements.</p>
                    <p><strong>• Sensor Rule:</strong> Non-invasive PPG and smart bottles are permitted under Examples 7 & 9.</p>
                `;
            } else if (sensor === 'microneedle') {
                // Piercing skin invalidates General Wellness (Example 8)
                card.className = "p-5 rounded-xl border border-rose-200 bg-rose-50/50 flex flex-col justify-between";
                badge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-rose-100 text-rose-800";
                badge.innerText = "Disqualified from Wellness";
                icon.innerText = "⚠️";
                title.innerText = "Invasive Medical Device (Class II SaMD)";
                desc.innerText = "Fails Jan 2026 General Wellness Example 8. Piercing skin or mucous membranes via microneedles strips low-risk status.";
                details.innerHTML = `
                    <p><strong>• Regulatory Action:</strong> Requires 510(k) or De Novo authorization.</p>
                    <p><strong>• Precedent:</strong> FDA July 2025 Warning Letters for uncleared continuous sensor integration.</p>
                `;
            } else if (compound !== 'caffeine' && sensor === 'continuous') {
                // Continuous wearable signals fail CDS Criterion 1
                card.className = "p-5 rounded-xl border border-amber-200 bg-amber-50/50 flex flex-col justify-between";
                badge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-amber-100 text-amber-800";
                badge.innerText = "Regulated SaMD (Class II / III)";
                icon.innerText = "⚖️";
                title.innerText = "Fails Non-Device CDS Criterion 1 & 3";
                desc.innerText = "Classified as Software as a Medical Device (SaMD) under the Jan 2026 CDS Final Guidance.";
                details.innerHTML = `
                    <p><strong>• Criterion 1 Failure:</strong> Ingesting sequential signal patterns (HRV, CGM, continuous PPG) invalidates CDS exclusion.</p>
                    <p><strong>• Criterion 3 Failure:</strong> Direct-to-patient dosing recommendations strip Non-Device CDS status.</p>
                    ${pharma === 'copackaged' ? '<p class="text-indigo-900 font-bold mt-1">• Oct 2026 PDURS Rule: Connected software MUST be described on FDA official drug prescribing label.</p>' : ''}
                `;
            } else if (compound !== 'caffeine' && sensor === 'discrete' && recipient === 'hcp') {
                // Non-Device CDS
                card.className = "p-5 rounded-xl border border-indigo-200 bg-indigo-50/50 flex flex-col justify-between";
                badge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-indigo-100 text-indigo-800";
                badge.innerText = "Non-Device CDS Exempt";
                icon.innerText = "🩺";
                title.innerText = "Excluded from Device Regulation";
                desc.innerText = "Meets all 4 statutory criteria of FD&C Act § 520(o)(1)(E) as clarified in Jan 2026 CDS Guidance.";
                details.innerHTML = `
                    <p><strong>• Criterion 1:</strong> Uses discrete lab values, not continuous wearable signal patterns.</p>
                    <p><strong>• Criterion 4:</strong> Displays full algorithm validation transparency so HCP can independently review basis.</p>
                `;
            } else {
                // Fallback SaMD
                card.className = "p-5 rounded-xl border border-slate-200 bg-slate-100 flex flex-col justify-between";
                badge.className = "text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded bg-slate-200 text-slate-800";
                badge.innerText = "Regulated SaMD";
                icon.innerText = "📱";
                title.innerText = "Class II Medical Device";
                desc.innerText = "Requires premarket clearance (510k/De Novo) and Section 524B cybersecurity controls.";
                details.innerHTML = `<p>Direct-to-patient prescription dose calculation requires formal FDA clinical trials.</p>`;
            }
        }
    </script>
